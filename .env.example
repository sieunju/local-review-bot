# 저장소 하나만 볼 때 (아래 REPOS를 설정하면 이 값들은 무시됨)
# gitea | github | gitlab
GIT_PROVIDER=gitea
# 저장소 경로 없이 서버 루트만. 생략 시 provider별 기본값 사용
# (gitea: http://localhost:3000, github: https://api.github.com, gitlab: https://gitlab.com)
GIT_URL=https://gitea.example.com
GIT_TOKEN=<gitea token>
REPO_OWNER=my-org
REPO_NAME=android-banking

# GitHub 사용 시
# GIT_PROVIDER=github
# GIT_TOKEN=<github PAT, repo 권한>

# GitLab 사용 시
# GIT_PROVIDER=gitlab
# GIT_TOKEN=<gitlab PAT, api scope>

# 여러 저장소(서로 다른 provider/서버 조합도 가능)를 볼 때는 REPOS를 JSON 배열로 설정.
# 설정되면 위 GIT_PROVIDER/GIT_URL/GIT_TOKEN/REPO_OWNER/REPO_NAME은 전부 무시됨.
# REPOS=[{"provider":"gitea","url":"http://localhost:3000","token":"<gitea token>","owner":"my-org","repo":"android-banking"},{"provider":"github","token":"<github PAT>","owner":"another-org","repo":"android-app"}]

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
REVIEW_INTERVAL=300
# 리뷰 코멘트 작성 언어 (예: ko, en, ja)
REVIEW_LANGUAGE=ko
