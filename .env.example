# 저장소 하나만 볼 때 (아래 REPOS를 설정하면 이 값들은 무시됨)
# gitea | github | gitlab
GIT_PROVIDER=gitea
# 저장소 경로 없이 서버 루트만. 생략 시 provider별 기본값 사용
# (gitea: http://localhost:3000, github: https://api.github.com, gitlab: https://gitlab.com)
GIT_URL=https://gitea.example.com
GIT_TOKEN=<gitea token>
REPO_OWNER=my-org
REPO_NAME=android-banking
# 리뷰 페르소나: android | ios | web. 생략 시 android
STACK=android

# GitHub 사용 시
# GIT_PROVIDER=github
# GIT_TOKEN=<github PAT, repo 권한>

# GitLab 사용 시
# GIT_PROVIDER=gitlab
# GIT_TOKEN=<gitlab PAT, api scope>

# 여러 저장소(서로 다른 provider/서버/스택 조합도 가능)를 볼 때는 REPOS를 JSON 배열로 설정.
# 설정되면 위 GIT_PROVIDER/GIT_URL/GIT_TOKEN/REPO_OWNER/REPO_NAME/STACK은 전부 무시됨.
# stack을 생략하면 android로 취급됨.
# REPOS=[{"provider":"gitea","url":"http://localhost:3000","token":"<gitea token>","owner":"my-org","repo":"android-banking","stack":"android"},{"provider":"github","token":"<github PAT>","owner":"another-org","repo":"ios-app","stack":"ios"},{"provider":"github","token":"<github PAT>","owner":"another-org","repo":"web-app","stack":"web"}]

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# 프롬프트 컨텍스트 윈도우 크기(토큰). 지정 안 하면 Ollama 기본값(4096)이 적용되어
# 가이드+diff가 길 때 프롬프트가 잘릴 수 있음
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.2
REVIEW_INTERVAL=300
# 리뷰 코멘트 작성 언어 (예: ko, en, ja)
REVIEW_LANGUAGE=ko

# --- Java→Kotlin 마이그레이션 리뷰 (android 스택 전용, 선택) ---
# "owner/repo" -> 로컬 클론 경로. PR diff에서 Foo.java -> Foo.kt 마이그레이션이
# 감지되면 이 경로의 저장소에서 base 브랜치를 fetch한 뒤 호출처를 grep해서
# 프롬프트에 주입함. **반드시 일반(non-bare) 클론이어야 함** — bare 클론은
# 지원 대상이 아님. 여기 등록 안 된 저장소는 마이그레이션이 감지돼도 경고 로그만
# 남기고 기존처럼 동작함.
# REPO_PATHS={"my-org/android-banking":"/Users/me/code/android-banking"}
# 위 grep 대상 base 브랜치. DiffRefs에 base sha가 없는 provider/PR일 때만 쓰이는 폴백
BASE_REF=origin/develop
